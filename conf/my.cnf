[client]
port=3306
socket=/var/packages/MySQL/target/Data/mysql.sock

[mysqld]
basedir=/var/packages/MySQL/target
datadir=/var/packages/MySQL/target/Data
port=3306
socket=/var/packages/MySQL/target/Data/mysql.sock
pid-file=/var/packages/MySQL/target/Data/mysql.pid
log-error=/var/packages/MySQL/target/logs/mysql-error.log
bind-address=0.0.0.0
skip-name-resolve
character-set-server=utf8mb4
collation-server=utf8mb4_general_ci
max_connections=200
innodb_buffer_pool_size=256M

#!/bin/bash
set -euo pipefail

MYSQL_VERSION="5.7.44"
SOURCE_ARCHIVE="$PWD/build/mysql-${MYSQL_VERSION}.tar.gz"
SOURCE_DIR="$PWD/build/mysql-${MYSQL_VERSION}"
BUILD_DIR="$PWD/build/mysql-build"
STAGE_DIR="$PWD/build/mysql-stage"
PACKAGE_ROOT="$PWD/build/package-root"

mkdir -p "$PWD/build"
if [ ! -f "$SOURCE_ARCHIVE" ]; then
    curl -fL --retry 3 \
      "https://dev.mysql.com/get/Downloads/MySQL-5.7/mysql-${MYSQL_VERSION}.tar.gz" \
      -o "$SOURCE_ARCHIVE"
fi

rm -rf "$SOURCE_DIR" "$BUILD_DIR" "$STAGE_DIR" "$PACKAGE_ROOT"
tar -xzf "$SOURCE_ARCHIVE" -C "$PWD/build"
mkdir -p "$BUILD_DIR" "$STAGE_DIR" "$PACKAGE_ROOT"

cd "$BUILD_DIR"
cmake "$SOURCE_DIR" \
  -DCMAKE_INSTALL_PREFIX=/usr/local/mysql \
  -DCMAKE_BUILD_TYPE=Release \
  -DWITH_BOOST=../boost \
  -DDOWNLOAD_BOOST=1 \
  -DWITH_SSL=bundled \
  -DWITH_ZLIB=system \
  -DWITH_UNIT_TESTS=OFF \
  -DWITH_INNODB_MEMCACHED=OFF \
  -DWITH_ARCHIVE_STORAGE_ENGINE=OFF \
  -DWITH_BLACKHOLE_STORAGE_ENGINE=OFF \
  -DWITH_FEDERATED_STORAGE_ENGINE=OFF \
  -DWITH_EXAMPLE_STORAGE_ENGINE=OFF \
  -DWITH_DEBUG=OFF \
  -DENABLE_DTRACE=OFF

make -j2
make install DESTDIR="$STAGE_DIR"
cp -a "$STAGE_DIR/usr/local/mysql/." "$PACKAGE_ROOT/"

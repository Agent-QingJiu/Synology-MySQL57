#!/bin/bash
set -euo pipefail

MYSQL_VERSION="5.7.44"
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SOURCE_ARCHIVE="$PROJECT_DIR/vendor/mysql-${MYSQL_VERSION}.tar.gz"
SOURCE_DIR="$PROJECT_DIR/build/mysql-${MYSQL_VERSION}"
BUILD_DIR="$PROJECT_DIR/build/mysql-build"
STAGE_DIR="$PROJECT_DIR/build/mysql-stage"
PACKAGE_ROOT="$PROJECT_DIR/build/package-root"

if [ ! -s "$SOURCE_ARCHIVE" ]; then
    echo "[ERROR] Missing vendored official MySQL source: $SOURCE_ARCHIVE" >&2
    echo "[ERROR] The GitHub Actions workflow must download it before Synology package build." >&2
    exit 1
fi

mkdir -p "$PROJECT_DIR/build"
rm -rf "$SOURCE_DIR" "$BUILD_DIR" "$STAGE_DIR" "$PACKAGE_ROOT"
tar -xzf "$SOURCE_ARCHIVE" -C "$PROJECT_DIR/build"
mkdir -p "$BUILD_DIR" "$STAGE_DIR" "$PACKAGE_ROOT"

cd "$BUILD_DIR"
cmake "$SOURCE_DIR" \
  -DCMAKE_INSTALL_PREFIX=/usr/local/mysql \
  -DCMAKE_BUILD_TYPE=Release \
  -DWITH_BOOST=../boost \
  -DDOWNLOAD_BOOST=1 \
  -DWITH_SSL=bundled \
  -DWITH_ZLIB=system \
  -DWITH_UNIT_TESTS=OFF \
  -DWITH_INNODB_MEMCACHED=OFF \
  -DWITH_ARCHIVE_STORAGE_ENGINE=OFF \
  -DWITH_BLACKHOLE_STORAGE_ENGINE=OFF \
  -DWITH_FEDERATED_STORAGE_ENGINE=OFF \
  -DWITH_EXAMPLE_STORAGE_ENGINE=OFF \
  -DWITH_DEBUG=OFF \
  -DENABLE_DTRACE=OFF

make -j2
make install DESTDIR="$STAGE_DIR"
cp -a "$STAGE_DIR/usr/local/mysql/." "$PACKAGE_ROOT/"

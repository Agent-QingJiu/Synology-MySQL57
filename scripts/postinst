#!/bin/sh
. "$(dirname "$0")/common"
check_target
if [ "${SYNOPKG_PKG_STATUS:-INSTALL}" = UPGRADE ]; then
    exit 0
fi

if ! managed_store; then
    [ ! -e "$store" ] && [ ! -L "$store" ] && [ ! -L /volume1/@appdata ] ||
        fail "Refusing to change an unmanaged persistent directory."
    if id "$account" >/dev/null 2>&1; then
        fail "Service account $account already exists."
    fi
    umask 077
    /usr/syno/sbin/synouser --add "$account" "$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')" \
        'MySQL native package service' 0 '' 0
    mkdir -p -m 755 /volume1/@appdata
    mkdir -m 755 "$store"
    : > "$marker"
    for directory in "$store/Data" "$runtime" "$logs"; do
        mkdir -m 700 "$directory"
        chown "$account" "$directory"
    done
    cp "$target/share/mysql57/my.cnf" "$config"
    chmod 600 "$config"
    ln -s "$store/Data" "$data"
    ln -s "$runtime" "$target/Runtime"
    ln -s "$logs" "$target/Logs"
    launch --initialize || fail "MySQL initialization failed. See $logs/error.log."
else
    id "$account" >/dev/null || fail "Preserved service account is missing."
    ln -s "$store/Data" "$data"
    ln -s "$runtime" "$target/Runtime"
    ln -s "$logs" "$target/Logs"
fi
check_data

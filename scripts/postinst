#!/bin/sh
set -eu
PKG_DIR="/var/packages/MySQL/target"
CONF_DIR="/var/packages/MySQL/etc"
PACKAGE_CONF="/var/packages/MySQL/conf/my.cnf"
mkdir -p "$CONF_DIR" "$PKG_DIR/Data" "$PKG_DIR/logs"
if [ ! -f "$CONF_DIR/my.cnf" ]; then
    cp "$PACKAGE_CONF" "$CONF_DIR/my.cnf"
fi
chown -R nobody:nobody "$PKG_DIR/Data" "$PKG_DIR/logs"
chmod 750 "$PKG_DIR/Data"
exit 0

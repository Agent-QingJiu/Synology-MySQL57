#!/bin/sh
. "$(dirname "$0")/common"

start() {
    check_target
    check_data
    if live_pid; then
        return
    fi
    if port_in_use; then
        fail "TCP port 3306 is already in use."
    fi
    launch --daemonize
    live_pid || fail "MySQL failed to start. See $logs/error.log."
}

stop() {
    if live_pid; then
        stopping=$pid
        kill -TERM "$stopping"
        elapsed=0
        while live_pid && [ "$pid" = "$stopping" ]; do
            [ "$elapsed" -lt 180 ] || fail "MySQL is still shutting down."
            sleep 1
            elapsed=$((elapsed + 1))
        done
    fi
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) live_pid || exit 3 ;;
    log) printf '%s\n' "$logs/error.log" ;;
    *) fail "Usage: $0 {start|stop|restart|status|log}" ;;
esac

import pathlib
import struct
import sys
import zlib

target = pathlib.Path(sys.argv[1])

def chunk(name, data):
    return (struct.pack(">I", len(data)) + name + data
            + struct.pack(">I", zlib.crc32(name + data)))

def pixel(x, y):
    x, y = x - 50, y - 50
    top = (x / 30) ** 2 + ((y + 22) / 10) ** 2 <= 1
    if top:
        return b"\x9c\xd8\xf6"
    for bottom in (-8, 7, 22):
        if abs(x) <= 30 and (bottom - 13 <= y <= bottom
                             or (y > bottom and (x / 30) ** 2 + ((y - bottom) / 10) ** 2 <= 1)):
            return b"\x4b\xa8\xd8"
    return b"\x15\x29\x3d"

for side, name in ((72, "PACKAGE_ICON.PNG"), (256, "PACKAGE_ICON_256.PNG")):
    rows = [b"\0" + b"".join(pixel(100 * x / side, 100 * y / side) for x in range(side))
            for y in range(side)]
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", side, side, 8, 2, 0, 0, 0))
    (target / name).write_bytes(png + chunk(b"IDAT", zlib.compress(b"".join(rows))) + chunk(b"IEND", b""))
